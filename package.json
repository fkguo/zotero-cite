{
	"name": "zotero-cite",
	"publisher": "XING",
	"displayName": "%displayName%",
	"repository": {
		"url": "https://gitee.com/rusterx/zotero-cite"
	},
	"description": "Cite and manage bibliography from zotero via json rpc",
	"version": "0.9.11",
	"engines": {
		"vscode": "^1.61.0"
	},
	"icon": "images/zotero.png",
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onCommand:zotero-cite.citeSmart",
		"onCommand:zotero-cite.showTaskPicker"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "zotero-cite.showTaskPicker",
				"title": "%command.showTaskPicker.title%",
				"icon": {
					"light": "images/cite-light.svg",
					"dark": "images/cite-dark.svg"
				}
			},
			{
				"command": "zotero-cite.citeSmart",
				"title": "%command.citeSmart.title%",
				"icon": {
					"light": "images/cite-light.svg",
					"dark": "images/cite-dark.svg"
				}
			},
			{
				"command": "zotero-cite.exportBibLatex",
				"title": "%command.exportBibLatex.title%"
			},
			{
				"command": "zotero-cite.addCitation",
				"title": "%command.addCitation.title%"
			},
			{
				"command": "zotero-cite.citeBibliography",
				"title": "%command.citeBibliography.title%"
			},
			{
				"command": "zotero-cite.citeMarkdownBibliography",
				"title": "%command.citeMarkdownBibliography.title%"
			},
			{
				"command": "zotero-cite.addHyperLinkCitation",
				"title": "%command.addHyperLinkCitation.title%"
			},
			{
				"command": "zotero-cite.updateBibtexFromZotero",
				"title": "%command.updateBibtexFromZotero.title%"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "zotero-cite.citeSmart",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'",
					"group": "navigation@10"
				}
			],
			"commandPalette": [
				{
					"command": "zotero-cite.showTaskPicker",
					"when": "editorTextFocus"
				},
				{
					"command": "zotero-cite.exportBibLatex",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.addCitation",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.citeBibliography",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.citeMarkdownBibliography",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.addHyperLinkCitation",
					"when": "editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.updateBibtexFromZotero",
					"when": "editorLangId == 'bibtex' || editorLangId == 'latex'"
				}
			]
		},
		"configuration": [
			{
				"type": "object",
				"title": "%configuration.title%",
				"properties": {
					"zotero-cite.bibliograpyStyle": {
						"type": "string",
						"default": "http://www.zotero.org/styles/apa",
						"description": "%configuration.bibliograpyStyle.description%",
						"scope": "window"
					},
					"zotero-cite.defaultBibName": {
						"type": "string",
						"default": "ref.bib",
						"scope": "window",
						"description": "%configuration.defaultBibName.description%"
					},
					"zotero-cite.latexBibStyle": {
						"type": "string",
						"default": "bibtex",
						"scope": "window",
						"description": "%configuration.latexBibStyle.description%"
					},
					"zotero-cite.excludedBibFields": {
						"type": "array",
						"default": [
							"file",
							"annotation"
						],
						"items": {
							"type": "string"
						},
						"scope": "window",
						"description": "%configuration.excludedBibFields.description%"
					},
					"zotero-cite.minimizeZotero": {
						"type": "string",
						"default": "",
						"scope": "window",
						"description": "%configuration.minimizeZotero.description%"
					},
					"zotero-cite.jsonRpcUrl": {
						"type": "string",
						"default": "http://localhost:23119/better-bibtex/json-rpc",
						"scope": "window",
						"description": "%configuration.jsonRpcUrl.description%"
					},
					"zotero-cite.caywUrl": {
						"type": "string",
						"default": "http://localhost:23119/better-bibtex/cayw",
						"scope": "window",
						"description": "%configuration.caywUrl.description%"
					},
					"zotero-cite.statusMessageDuration": {
						"type": "number",
						"default": 1500,
						"minimum": 300,
						"scope": "window",
						"description": "%configuration.statusMessageDuration.description%"
					},
					"zotero-cite.showCommandPickerInStatusBar": {
						"type": "boolean",
						"default": true,
						"scope": "window",
						"description": "%configuration.showCommandPickerInStatusBar.description%"
					},
					"zotero-cite.showMarkdownCitationHoverPreview": {
						"type": "boolean",
						"default": true,
						"scope": "window",
						"description": "%configuration.showMarkdownCitationHoverPreview.description%"
					},
					"zotero-cite.showMarkdownCitationCompletion": {
						"type": "boolean",
						"default": true,
						"scope": "window",
						"description": "%configuration.showMarkdownCitationCompletion.description%"
					}
				}
			}
		]
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"vscode:prepublish": "npm run compile",
		"lint": "eslint .",
		"sync:prs": "node ./scripts/sync-remote-prs.js",
		"sync:prs:dry": "node ./scripts/sync-remote-prs.js --dry-run",
		"pretest": "npm run compile && npm run lint",
		"test": "node ./test/runTest.js"
	},
	"devDependencies": {
		"@types/vscode": "^1.61.0",
		"@types/glob": "^7.1.4",
		"@types/mocha": "^9.0.0",
		"@types/node": "14.x",
		"eslint": "^7.32.0",
		"glob": "^7.1.7",
		"mocha": "^9.1.1",
		"typescript": "^4.4.3",
		"@vscode/test-electron": "^1.6.2"
	},
	"dependencies": {
		"@orcid/bibtex-parse-js": "0.0.25",
		"axios": "^0.24.0"
	},
	"__metadata": {
		"id": "92d25ab9-444d-4394-a0ef-4cfa5f705b73",
		"publisherId": "4510c0ac-2bcc-4bca-a8f9-d61e73c8def8",
		"publisherDisplayName": "XING",
		"targetPlatform": "undefined",
		"isApplicationScoped": false,
		"isPreReleaseVersion": false,
		"hasPreReleaseVersion": false,
		"installedTimestamp": 1728478986021,
		"pinned": false,
		"preRelease": false,
		"source": "gallery"
	}
}

{
	"name": "zotero-cite",
	"publisher": "XING",
	"displayName": "%displayName%",
	"repository": {
		"type": "git",
		"url": "https://github.com/fkguo/zotero-cite.git"
	},
	"description": "Insert Zotero citations and automatically update .bib files in VS Code and compatible VS Code-based editors, with optional INSPIRE-HEP support.",
	"version": "0.11.3",
	"engines": {
		"vscode": "^1.61.0"
	},
	"icon": "images/zotero.png",
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onCommand:zotero-cite.citeSmart",
		"onCommand:zotero-cite.showTaskPicker"
	],
	"extensionKind": [
		"ui",
		"workspace"
	],
	"capabilities": {
		"virtualWorkspaces": {
			"supported": true,
			"description": "%capabilities.virtualWorkspaces.description%"
		},
		"untrustedWorkspaces": {
			"supported": false,
			"description": "%capabilities.untrustedWorkspaces.description%"
		}
	},
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "zotero-cite.showTaskPicker",
				"title": "%command.showTaskPicker.title%",
				"icon": {
					"light": "images/cite-light.svg",
					"dark": "images/cite-dark.svg"
				}
			},
			{
				"command": "zotero-cite.citeSmart",
				"title": "%command.citeSmart.title%",
				"icon": {
					"light": "images/cite-light.svg",
					"dark": "images/cite-dark.svg"
				}
			},
			{
				"command": "zotero-cite.exportBibLatex",
				"title": "%command.exportBibLatex.title%"
			},
			{
				"command": "zotero-cite.addCitation",
				"title": "%command.addCitation.title%"
			},
			{
				"command": "zotero-cite.citeBibliography",
				"title": "%command.citeBibliography.title%"
			},
			{
				"command": "zotero-cite.citeMarkdownBibliography",
				"title": "%command.citeMarkdownBibliography.title%"
			},
			{
				"command": "zotero-cite.addHyperLinkCitation",
				"title": "%command.addHyperLinkCitation.title%"
			},
			{
				"command": "zotero-cite.updateBibtexFromZotero",
				"title": "%command.updateBibtexFromZotero.title%"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "zotero-cite.citeSmart",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'",
					"group": "navigation@10"
				}
			],
			"commandPalette": [
				{
					"command": "zotero-cite.showTaskPicker",
					"when": "editorTextFocus"
				},
				{
					"command": "zotero-cite.exportBibLatex",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.addCitation",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.citeBibliography",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.citeMarkdownBibliography",
					"when": "editorLangId == 'latex' || editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.addHyperLinkCitation",
					"when": "editorLangId == 'markdown' || resourceExtname == '.qmd' || resourceExtname == '.rmd' || resourceExtname == '.mdx'"
				},
				{
					"command": "zotero-cite.updateBibtexFromZotero",
					"when": "editorLangId == 'bibtex' || editorLangId == 'latex'"
				}
			]
		},
		"configuration": [
			{
				"type": "object",
				"title": "%configuration.title%",
				"properties": {
					"zotero-cite.bibliograpyStyle": {
						"type": "string",
						"default": "http://www.zotero.org/styles/apa",
						"description": "%configuration.bibliograpyStyle.description%",
						"scope": "window"
					},
					"zotero-cite.defaultBibName": {
						"type": "string",
						"default": "ref.bib",
						"scope": "window",
						"description": "%configuration.defaultBibName.description%"
					},
					"zotero-cite.latexBibStyle": {
						"type": "string",
						"default": "bibtex",
						"scope": "window",
						"description": "%configuration.latexBibStyle.description%"
					},
					"zotero-cite.latexCitationCommand": {
						"type": "string",
						"default": "cite",
						"scope": "window",
						"description": "%configuration.latexCitationCommand.description%"
					},
					"zotero-cite.excludedBibFields": {
						"type": "array",
						"default": [
							"file",
							"annotation"
						],
						"items": {
							"type": "string"
						},
						"scope": "window",
						"description": "%configuration.excludedBibFields.description%"
					},
					"zotero-cite.minimizeZotero": {
						"type": "string",
						"default": "",
						"scope": "window",
						"description": "%configuration.minimizeZotero.description%"
					},
					"zotero-cite.jsonRpcUrl": {
						"type": "string",
						"default": "http://localhost:23119/better-bibtex/json-rpc",
						"scope": "window",
						"description": "%configuration.jsonRpcUrl.description%"
					},
					"zotero-cite.caywUrl": {
						"type": "string",
						"default": "http://localhost:23119/better-bibtex/cayw",
						"scope": "window",
						"description": "%configuration.caywUrl.description%"
					},
					"zotero-cite.bibtexSource": {
						"type": "string",
						"enum": [
							"better-bibtex",
							"zotero-inspire"
						],
						"enumDescriptions": [
							"%configuration.bibtexSource.betterBibtex%",
							"%configuration.bibtexSource.zoteroInspire%"
						],
						"default": "better-bibtex",
						"scope": "window",
						"description": "%configuration.bibtexSource.description%"
					},
					"zotero-cite.zoteroInspireBibtexUrl": {
						"type": "string",
						"default": "http://127.0.0.1:23119/connector/zinspireBibtex",
						"scope": "machine",
						"description": "%configuration.zoteroInspireBibtexUrl.description%"
					},
					"zotero-cite.statusMessageDuration": {
						"type": "number",
						"default": 1500,
						"minimum": 300,
						"scope": "window",
						"description": "%configuration.statusMessageDuration.description%"
					},
					"zotero-cite.showCommandPickerInStatusBar": {
						"type": "boolean",
						"default": true,
						"scope": "window",
						"description": "%configuration.showCommandPickerInStatusBar.description%"
					},
					"zotero-cite.showMarkdownCitationHoverPreview": {
						"type": "boolean",
						"default": true,
						"scope": "window",
						"description": "%configuration.showMarkdownCitationHoverPreview.description%"
					},
					"zotero-cite.showMarkdownCitationCompletion": {
						"type": "boolean",
						"default": true,
						"scope": "window",
						"description": "%configuration.showMarkdownCitationCompletion.description%"
					}
				}
			}
		]
	},
	"scripts": {
		"compile": "tsc -p ./ && npm run bundle",
		"bundle": "node ./scripts/esbuild.js",
		"bundle:production": "node ./scripts/esbuild.js --production",
		"watch": "node ./scripts/esbuild.js --watch",
		"vscode:prepublish": "npm run package",
		"package": "tsc -p ./ && npm run bundle:production",
		"lint": "eslint . --ext .ts,.js",
		"sync:prs": "node ./scripts/sync-remote-prs.js",
		"sync:prs:dry": "node ./scripts/sync-remote-prs.js --dry-run",
		"pretest": "npm run compile && npm run lint",
		"test": "npm run test:unit",
		"test:unit": "mocha --ui tdd \"test/unit/**/*.test.js\"",
		"test:integration": "node ./test/runTest.js",
		"test:virtual-workspace": "node ./test/virtualWorkspace.js"
	},
	"devDependencies": {
		"@orcid/bibtex-parse-js": "0.0.25",
		"@types/glob": "^8.1.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^14.18.63",
		"@types/vscode": "1.61.0",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"@vscode/test-electron": "^2.4.1",
		"axios": "^1.20.0",
		"esbuild": "0.28.2",
		"eslint": "^8.57.1",
		"glob": "^8.1.0",
		"mocha": "^10.8.2",
		"typescript": "^5.1.6"
	},
	"overrides": {
		"brace-expansion@1.1.11": "1.1.18",
		"flatted@3.3.3": "3.4.2",
		"minimatch@3.1.2": "3.1.4",
		"picomatch@2.3.1": "2.3.2",
		"serialize-javascript@6.0.2": "7.0.5"
	},
	"__metadata": {
		"id": "92d25ab9-444d-4394-a0ef-4cfa5f705b73",
		"publisherId": "4510c0ac-2bcc-4bca-a8f9-d61e73c8def8",
		"publisherDisplayName": "XING",
		"targetPlatform": "undefined",
		"isApplicationScoped": false,
		"isPreReleaseVersion": false,
		"hasPreReleaseVersion": false,
		"installedTimestamp": 1728478986021,
		"pinned": false,
		"preRelease": false,
		"source": "gallery"
	},
	"license": "MIT",
	"homepage": "https://github.com/fkguo/zotero-cite#readme",
	"bugs": {
		"url": "https://github.com/fkguo/zotero-cite/issues"
	}
}

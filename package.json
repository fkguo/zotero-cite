{
  "name": "zotero-export",
  "publisher": "XING",
  "displayName": "Zotero Export",
  "repository": {"url": "https://gitee.com/rusterx/zotero-export"},
  "description": "Export bibliography from zotero via json rpc",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.61.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:zotero-export.exportEntries"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zotero-export.exportEntries",
        "title": "Zotero: Export Bibliography Entries"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.61.0",
    "@types/glob": "^7.1.4",
    "@types/mocha": "^9.0.0",
    "@types/node": "14.x",
    "eslint": "^7.32.0",
    "glob": "^7.1.7",
    "mocha": "^9.1.1",
    "typescript": "^4.4.3",
    "@vscode/test-electron": "^1.6.2"
  },
  "dependencies": {
    "axios": "^0.24.0"
  }
}
